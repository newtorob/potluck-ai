[Unit]
Description=Potluck mesh firewall accept rules (Tailscale + Mullvad coexistence)
Documentation=https://github.com/newtorob/potluckai/blob/main/scripts/systemd/README.md
# Run after both VPN daemons settle so their chains/tables exist before we try
# to insert into them. We don't HARD-require them — install-firewall-rules.sh
# detects each one independently and no-ops if absent.
After=network-online.target tailscaled.service mullvad-daemon.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@FIREWALL_SCRIPT@ --install
ExecStop=@FIREWALL_SCRIPT@ --uninstall
# If the VPN daemon flushes its rules at runtime (e.g. Mullvad reconnect), our
# accept gets wiped. The accompanying potluck-mesh.service depends on this
# unit, so a `systemctl restart potluck-firewall.service` re-installs.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

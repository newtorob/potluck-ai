#!/usr/bin/env bash
# Potluck pre-commit hook.
#
# Runs the privacy-invariant lint (lint #20 + #21) before every commit.
# Aborts the commit if violations are detected. Designed to be fast
# (~0.5s on a normal-sized changeset) so it doesn't bottleneck the
# inner-loop dev experience.
#
# Installed by: `make install-hooks` (copies this file into .git/hooks/).
# Bypass on a single commit (rare, but possible): `git commit --no-verify`.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Only run if the lint script exists — keeps the hook safe in older
# clones / on branches that pre-date the lint.
if [ -x "$REPO_ROOT/scripts/lint_privacy.py" ]; then
  python3 "$REPO_ROOT/scripts/lint_privacy.py" || {
    echo
    echo "Privacy lint failed — commit aborted."
    echo "Fix the violations above, or use 'git commit --no-verify' to bypass"
    echo "(only do this if you're certain the flagged code is safe AND have"
    echo "updated the whitelist in scripts/lint_privacy.py)."
    exit 1
  }
fi

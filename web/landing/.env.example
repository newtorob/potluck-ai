# Formspree form endpoint for the waitlist signup.
# Create a form at https://formspree.io, copy the endpoint URL from its
# Integration tab, and paste it here. Free tier handles 50 submissions/month.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Canonical site URL — used by metadataBase (layout.tsx) and sitemap.ts.
# On Vercel preview deployments set this to VERCEL_URL so OG and sitemap
# entries resolve to the preview domain rather than the production domain.
# In production, leave this unset (falls back to https://potluck.ai).
# Example for preview deploys: NEXT_PUBLIC_SITE_URL=https://$VERCEL_URL
NEXT_PUBLIC_SITE_URL=

+                      'max_quote_length': MAX_QUOTE_LENGTH, 'omitted_snippets': omitted,
+                      'omitted_characters': omitted_characters,
+                      'whitespace_only_characters': whitespace_only_characters,
+                      'split_blocks': split_blocks, 'truncated': omitted > 0}

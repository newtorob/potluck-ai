{
  "name": "potluck-ai-desktop",
  "version": "0.1.6",
  "description": "Potluck AI — local-first AI on a member-operated mesh network",
  "main": "main.js",
  "author": "Potluck AI",
  "homepage": "https://trypotluck.ai",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "concurrently --kill-others --names \"VITE,PY,ELECTRON\" --prefix-colors \"magenta,yellow,cyan\" \"pnpm --dir ../frontend dev\" \"pnpm run dev:python\" \"wait-on http-get://localhost:5173 http-get://127.0.0.1:8321/health && cross-env NODE_ENV=development electron .\"",
    "dev:python": "node scripts/run-python-dev.js",
    "build": "electron-builder",
    "hash-release": "node scripts/hash-release.js",
    "build:mac": "electron-builder --mac && node scripts/hash-release.js",
    "build:win": "electron-builder --win && node scripts/hash-release.js",
    "build:linux": "electron-builder --linux && node scripts/hash-release.js",
    "prepack:frontend": "cd ../frontend && pnpm exec vite build",
    "prepack:python": "rm -rf resources/python && mkdir -p resources/python && bash scripts/sign-sidecars.sh ../python/dist/potluck-local && cp -R ../python/dist/potluck-local resources/python/",
    "prepack:mcp": "bash scripts/sign-sidecars.sh ../python/dist/potluck-mcp && cp -R ../python/dist/potluck-mcp resources/python/",
    "prepack:mesh": "make -C ../go/potluck-mesh build && bash scripts/sign-sidecars.sh ../go/potluck-mesh/dist && rm -rf resources/mesh && mkdir -p resources/mesh && cp ../go/potluck-mesh/dist/potluck-mesh* resources/mesh/ && ([ -f ../go/potluck-mesh/dist/wintun.dll ] && cp ../go/potluck-mesh/dist/wintun.dll resources/mesh/ || true)",
    "prepack:mesh-helper": "bash native/mesh-helper/build.sh",
    "prepack:build-info": "node scripts/generate-build-info.js",
    "prepack": "pnpm run prepack:frontend && pnpm run prepack:python && pnpm run prepack:mcp && pnpm run prepack:mesh && pnpm run prepack:mesh-helper && pnpm run prepack:build-info",
    "package": "pnpm run prepack && pnpm run build",
    "clean": "rimraf dist out resources/python resources/mesh resources/mesh-helper build-info.json"
  },
  "build": {
    "afterSign": "scripts/notarize.js",
    "beforePack": "scripts/check-native-architecture.js",
    "appId": "ai.trypotluck.app",
    "productName": "Potluck AI",
    "protocols": [
      {
        "name": "Potluck",
        "schemes": ["potluck"]
      }
    ],
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      "icons/**/*",
      "build-info.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist/",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "./resources/python/",
        "to": "python",
        "filter": ["**/*"]
      },
      {
        "from": "./resources/mesh/",
        "to": "mesh",
        "filter": ["**/*"]
      },
      {
        "from": "../../../packaging/linux/mesh-install-helper.sh",
        "to": "mesh-install-helper.sh"
      },
      {
        "from": "../../../packaging/linux/polkit/ai.trypotluck.mesh.policy",
        "to": "ai.trypotluck.mesh.policy"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist",
      "icon": "icons/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "notarize": false,
      "extraFiles": [
        {
          "from": "../../../packaging/daemons/ai.trypotluck.mesh.plist",
          "to": "Library/LaunchDaemons/ai.trypotluck.mesh.plist"
        },
        {
          "from": "./resources/mesh-helper/mesh-helper",
          "to": "MacOS/mesh-helper"
        }
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "extraResources": [
        {
          "from": "../../../packaging/windows/mesh-install-helper.ps1",
          "to": "mesh-install-helper.ps1"
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Utility",
      "synopsis": "Member-operated mesh for local-first AI",
      "description": "Potluck is local-first AI that runs on machines you own. Local-first memory for AI coding agents, a WireGuard mesh between your machines, and a member-operated compute network.",
      "maintainer": "Potluck AI <hello@trypotluck.ai>",
      "vendor": "Potluck AI"
    },
    "deb": {
      "afterInstall": "../../../packaging/linux/deb-postinst.sh",
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "policykit-1"]
    },
    "publish": {
      "provider": "generic",
      "url": "https://releases.trypotluck.ai"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.6",
    "rimraf": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "electron-winstaller",
      "esbuild"
    ]
  }
}

# Python sidecar (local, never leaves the machine)
VITE_LOCAL_API_URL=http://127.0.0.1:8321

# Cloud API (account, membership, billing - no prompts)
VITE_CLOUD_API_URL=https://api.trypotluck.ai

# Cooperative/household coordinator. Unset here on purpose - the app defaults to
# http://127.0.0.1:8400 and the user overrides it at runtime in Settings.
# VITE_COORDINATOR_URL=

# --- Env-file precedence (important for release builds) ---------------------
# Vite loads, highest precedence first:
#   .env.[mode].local  >  .env.local  >  .env.[mode]  >  .env
# `.env.local` loads in all modes, including production (`vite build`), and it
# outranks the committed `.env.production`. So any personal machine override
# that must not ship in an installer (e.g. pointing the coordinator at your own
# Tailscale IP) goes in `.env.development.local` - which loads only in dev mode
# - not in `.env.local`. Putting it in `.env.local` bakes it into every
# `make installer-*` build.

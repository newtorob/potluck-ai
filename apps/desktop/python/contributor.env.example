# Copy this file to .env and edit the placeholders below.
# The sidecar auto-loads .env from its working directory.
#
# Find the LAN IP of the machine running the coordinator:
#   macOS:    ipconfig getifaddr en0
#   Linux:    hostname -I | awk '{print $1}'
#   Windows:  ipconfig | findstr IPv4
# Or its Tailscale IP if you're on a different network: tailscale ip -4

# Pick a hash that exists in coordinator.contributor_releases:
POTLUCK_BINARY_HASH=59b74f2ea0e8b6f23f3672336f90c97435b1dfa13ef7aabc1994b61c54c7d65a

# Replace this with the coordinator machine's actual IP - the placeholder will not work:
POTLUCK_COORDINATOR_URL=ws://REPLACE_WITH_COORDINATOR_IP:8400/peers/connect

# Dev member fixture (any UUID works):
POTLUCK_MEMBER_ID=00000000-0000-0000-0000-000000000001

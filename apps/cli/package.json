{
  "name": "@potluck/cli",
  "version": "0.1.0",
  "description": "Potluck CLI — a terminal coding agent whose inference runs on the Potluck mesh via the local OpenAI-compatible gateway.",
  "type": "module",
  "bin": {
    "potluck": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
